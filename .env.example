# LLM (required for the synth / risk nodes)
DS_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Where sessions, transcripts and profiles are stored (defaults to ./data)
# PSY_DATA_ROOT=

# Optional: HuggingFace mirror for the ASR / diarisation models
# HF_ENDPOINT=https://hf-mirror.com

# ---- ASR (optional) ---------------------------------------------------------
# Session language and faster-whisper model size (defaults: zh / small).
PSY_LANG=zh
PSY_ASR_MODEL=small
